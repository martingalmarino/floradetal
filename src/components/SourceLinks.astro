---
import Icon from './Icon.astro';
import { getSource } from '../lib/data';

interface Props {
  ids: string[];
  showScope?: boolean;
}

const { ids, showScope = false } = Astro.props;
const sources = [...new Set(ids)].map(getSource).filter((source) => source.public);
---

{
  sources.length > 0 && (
    <ul class="source-list">
      {sources.map((source) => (
        <li>
          <a href={source.url} rel="noopener" target="_blank">
            {source.title}
            <Icon name="external" size={14} />
            <span class="visually-hidden">(se abre en otra pestaña)</span>
          </a>
          {showScope && source.scopeNote && <span class="muted"> — {source.scopeNote}</span>}
        </li>
      ))}
    </ul>
  )
}
